+const builtinConfigEnv = { ZCODE_BUILTIN_PROVIDER_CONFIG_FILE: repoBuiltinConfigFile };
+
+test("standalone catalog admits both Individual and Start providers", async () => {
+  const providers = await readStandaloneCodingPlanProviders(builtinConfigEnv);
+  const modes = [...new Set(providers.map((provider) => provider.mode))].sort();
+  assert.deepEqual(modes, ["individual-coding-plan", "start-plan"]);
+  const zaiProviders = providers.filter((provider) => provider.family === "zai");
+  assert.equal(zaiProviders.length, 2);
+  const zaiStart = zaiProviders.find((provider) => provider.mode === "start-plan");
+  assert.equal(zaiStart?.providerId, "account:zai-start-plan");
+  assert.match(zaiStart?.modelId ?? "", /^GLM-/);
+});
