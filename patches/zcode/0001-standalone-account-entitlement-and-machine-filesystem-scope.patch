+
+    // 手工 API Key 路径不写 activeProvider/OAuth 材料 → 不得误判成 Start 权益。
+    const manualKeyOnly = fakeCredentialStore({
+      "account-provider:account:zai-individual-coding-plan:identity": "key-abc",
+      "account-provider:coding-plan:account:zai-individual-coding-plan:account:key-abc:api-key":
+        "test-individual-key",
