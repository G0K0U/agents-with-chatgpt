+    const manualEntitlement = await readStandaloneStartPlanEntitlementByFamily(manualKeyOnly);
+    assert.equal(manualEntitlement.get("zai"), false);
+    const manualSnapshot = await readStandaloneAccountProviderConfigSnapshot(manualKeyOnly, env);
+    const manualAccess = manualSnapshot.providers.get("account:zai-start-plan")?.access;
+    assert.equal(manualAccess?.type === "zhipu-account" ? manualAccess.entitled : false, false);
+    assert.equal(
+      manualSnapshot.providers.get("account:zai-individual-coding-plan")?.access?.type ===
