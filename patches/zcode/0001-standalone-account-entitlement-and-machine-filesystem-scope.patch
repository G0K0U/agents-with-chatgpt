@@ -0,0 +1,201 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import type { Logger, LogContext } from "@zcode/contracts";
+import {
+  ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV,
+  isStandaloneAccountRuntimeEnabled,
+  standaloneAccountRuntimeOptions,
+} from "../src/zcode-protocol-entrypoint.js";
+
+function recordingLogger() {
+  const calls: Array<{ level: string; message: string; context?: LogContext }> = [];
+  const logger: Logger = {
+    debug(message, context) {
+      calls.push({ level: "debug", message, context });
+    },
+    info(message, context) {
+      calls.push({ level: "info", message, context });
+    },
+    warn(message, context) {
+      calls.push({ level: "warn", message, context });
+    },
+    error() {},
+    child() {
+      return logger;
+    },
+  };
+  return { logger, calls };
+}
+
+test("standalone account runtime is opt-in only (fail-closed default)", () => {
+  assert.equal(isStandaloneAccountRuntimeEnabled({}), false);
+  assert.equal(isStandaloneAccountRuntimeEnabled({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "" }), false);
+  assert.equal(isStandaloneAccountRuntimeEnabled({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "0" }), false);
+  assert.equal(isStandaloneAccountRuntimeEnabled({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "false" }), false);
+  assert.equal(isStandaloneAccountRuntimeEnabled({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "off" }), false);
+  assert.equal(isStandaloneAccountRuntimeEnabled({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "yes" }), false);
+  assert.equal(isStandaloneAccountRuntimeEnabled({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: " true " }), true);
+  assert.equal(isStandaloneAccountRuntimeEnabled({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "TRUE" }), true);
+  assert.equal(isStandaloneAccountRuntimeEnabled({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "1" }), true);
+});
+
+test("desktop-host default keeps the protocol entrypoint on the host-delivered path", () => {
+  const { logger } = recordingLogger();
+  assert.deepEqual(standaloneAccountRuntimeOptions({}, logger), {});
+  assert.deepEqual(
+    standaloneAccountRuntimeOptions({ [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "0" }, logger),
+    {},
+  );
+});
+
+test("opt-in wires observability callbacks only; no entitlement bypass is constructed", () => {
+  const { logger, calls } = recordingLogger();
+  const options = standaloneAccountRuntimeOptions(
+    { [ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]: "1" },
+    logger,
+  );
+  const standalone = options.standalone;
+  assert.ok(standalone, "opt-in must produce a standalone block");
+  // 只允许观测回调：凭据 store、请求通道与旧配置导入都走 runtime 默认实现，
+  // 这里不允许出现任何注入面（无 credentialStore/request/legacyCliUserConfigFilePath 字段）。
+  assert.deepEqual(Object.keys(standalone).sort(), [
+    "onAccountInitializationError",
+    "onBuiltinRefreshError",
+    "onBuiltinRefreshResult",
+  ]);
+
+  // 回调只记录事实且不得抛出——观测失败不能改变账号解析结果。
+  assert.doesNotThrow(() => standalone.onAccountInitializationError?.(new Error("store unavailable")));
+  assert.doesNotThrow(() => standalone.onBuiltinRefreshError?.("boom"));
+  assert.doesNotThrow(() =>
+    standalone.onBuiltinRefreshResult?.({ result: "updated", revision: 7 }),
+  );
+  assert.equal(calls.filter((call) => call.level === "warn").length, 2);
+  const refresh = calls.find((call) => call.context?.event === "zcode_protocol.provider_registry.builtin_refresh_result");
+  assert.ok(refresh);
+  assert.equal((refresh.context as Record<string, unknown>).revision, 7);
+  // 日志只含错误消息与刷新事实，不携带任何凭据材料字段。
+  for (const call of calls) {
+    const text = JSON.stringify(call);
+    assert.match(text, /^[\s\S]{1,500}$/);
+    assert.equal(/api[-_]?key|token|jwt|secret/i.test(text), false);
+  }
+});
+
+// ── entitlement route reasoning level (standalone plan routing) ──────────
+import { resolveEntitlementRouteReasoningLevel } from "../src/zcode-protocol/session-entitlement.js";
+import type { ZCodeModelOption } from "@zcode/shared";
+
+function option(levels: string[], defaultLevel?: string): ZCodeModelOption {
+  return {
+    ref: { providerId: "account:zai-start-plan", modelId: "GLM-5.3-Flash" },
+    label: "GLM-5.3-Flash",
+    providerLabel: "account:zai-start-plan",
+    reasoning: {
+      levels: levels.map((value) => ({ value, label: value })),
+      ...(defaultLevel !== undefined ? { defaultLevel } : {}),
+    },
+  } as unknown as ZCodeModelOption;
+}
+
+test("entitlement route reasoning level: requested level wins when supported", () => {
+  const matched = option(["low", "high", "max"]);
+  assert.equal(resolveEntitlementRouteReasoningLevel(matched, "max"), "max");
+  assert.equal(resolveEntitlementRouteReasoningLevel(matched, " max "), "max");
+  // Unsupported requested level falls back to the model's own default —
+  // never to an unsupported or invented level.
+  assert.equal(resolveEntitlementRouteReasoningLevel(matched, "ultra"), "max");
+  assert.equal(resolveEntitlementRouteReasoningLevel(matched, undefined), "max");
+});
+
+test("entitlement route reasoning level: no levels or no default stays unset", () => {
+  assert.equal(resolveEntitlementRouteReasoningLevel(option([]), "max"), undefined);
+  // A model declaring levels without an explicit default uses the last level.
+  const noDefault = option(["low", "high"]);
+  assert.equal(resolveEntitlementRouteReasoningLevel(noDefault, undefined), "high");
+});
+
+// ── standalone Individual identity resolution (Desktop-host parity) ──────
+import { join } from "node:path";
+import {
+  SHARED_ZCODE_CREDENTIAL_KEYS,
+  type SharedZCodeCredentialStore,
+} from "@zcode/adapters/auth";
+import { readStandaloneAccountProviderConfigSnapshot } from "../src/app/standalone-account-provider-runtime.js";
+
+function fakeCredentialStore(initial: Record<string, string>): SharedZCodeCredentialStore {
+  const values = new Map(Object.entries(initial));
+  return {
+    filePath: "<memory>",
+    async clearZaiLoginCredentials() {},
+    async delete() {},
+    async deleteIfValue() { return false; },
+    async deleteIfValues() { return {}; },
+    async deleteManyIfValue() { return false; },
+    async load(key) { return values.get(key) ?? null; },
+    async loadMany(keys) {
+      return Object.fromEntries(keys.map((key) => [key, values.get(key) ?? null]));
+    },
+    async save() {},
+    async saveMany(entries) {
+      for (const [key, value] of Object.entries(entries)) values.set(key, value);
+    },
+    async saveReplacing() {},
+    async saveZaiLoginCredentials() {},
+  } as unknown as SharedZCodeCredentialStore;
+}
+
+const repoBuiltinConfigFile = join(
+  import.meta.dirname,
+  "../../../../../config/provider/zcode-builtin.json",
+);
+const builtinConfigEnv = { ZCODE_BUILTIN_PROVIDER_CONFIG_FILE: repoBuiltinConfigFile };
+const INDIVIDUAL_PROVIDER = "account:zai-individual-coding-plan";
+
+function isEntitled(snapshot: { providers: Map<string, { access?: { type?: string; entitled?: boolean } }> }, providerId: string): boolean {
+  const access = snapshot.providers.get(providerId)?.access;
+  return access?.type === "zhipu-account" ? access.entitled === true : false;
+}
+
+test("individual entitlement resolves via OAuth user profile identity (host parity)", async () => {
+  // Exactly the state observed on this machine: OAuth login material + the
+  // Desktop-host-cached coding-plan api-key, but NO per-provider identity key
+  // (the host derives the identity from the profile and never writes it).
+  const store = fakeCredentialStore({
+    [SHARED_ZCODE_CREDENTIAL_KEYS.activeProvider]: "zai",
+    [SHARED_ZCODE_CREDENTIAL_KEYS.zaiUserInfo]: JSON.stringify({ id: "user-1" }),
+    "account-provider:coding-plan:account:zai-individual-coding-plan:account:user-1:api-key":
+      "test-individual-key",
+  });
+  const snapshot = await readStandaloneAccountProviderConfigSnapshot(store, builtinConfigEnv);
+  assert.equal(isEntitled(snapshot, INDIVIDUAL_PROVIDER), true);
+});
+
+test("individual entitlement stays fail-closed without the cached api-key", async () => {
