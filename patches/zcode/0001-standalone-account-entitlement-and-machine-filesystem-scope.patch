--- /dev/null
+++ b/apps/zcode-cli/packages/core/src/tool/filesystem-scope.ts
@@ -0,0 +1,76 @@
+import { realpath } from "node:fs/promises";
+import { dirname, isAbsolute, relative, resolve, sep } from "node:path";
+
+export const LOCAL_FILESYSTEM_TOOLS = new Set(["Read", "Write", "Edit", "Glob", "Grep", "Bash"]);
+const ACCOUNT_PATH = /(?:^|[\\/])(?:\.env(?:\.[^\\/]+)?|\.npmrc|\.netrc|\.pypirc|\.ssh|\.aws|\.azure|\.zcode|\.codex|\.cloudflared|credentials?(?:\.[^\\/]+)?|security\.json|auth\.json|cookies?)(?:$|[\\/])/i;
+
+/** Lexical rejection happens before normalization can erase namespace markers. */
+export function isOrdinaryLocalPath(value: string): boolean {
+  if (!value || /[\x00-\x1f]/.test(value) || /^[\\/]{2}/.test(value)) return false;
+  if (/^[a-z]:[^\\/]/i.test(value) || /^[a-z]:$/i.test(value)) return false;
+  const withoutDrive = value.replace(/^[a-z]:/i, "");
+  if (withoutDrive.includes(":")) return false;
+  if (/(?:^|[\\/])(?:con|prn|aux|nul|com[0-9]|lpt[0-9])(?:\.|[\\/]|$)/i.test(withoutDrive)) return false;
+  if (/^\/(?:dev|proc|sys)(?:\/|$)/.test(value)) return false;
+  return !ACCOUNT_PATH.test(value);
+}
+
+async function canonicalTarget(target: string): Promise<string> {
+  let ancestor = target;
+  for (;;) {
+    try {
+      return resolve(await realpath(ancestor), relative(ancestor, target));
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "ENOENT") throw error;
+      const parent = dirname(ancestor);
+      if (parent === ancestor) throw new Error("Filesystem path cannot be resolved");
+      ancestor = parent;
+    }
+  }
+}
+
+function contained(root: string, target: string): boolean {
+  const rel = relative(root, target);
+  return rel !== ".." && !rel.startsWith(`..${sep}`) && !isAbsolute(rel);
+}
+
+export interface FilesystemScopeContext {
+  filesystemScope?: "workspace" | "machine";
+  workingDirectory: string;
+  workspaceRoot: string;
+}
+
+export async function assertFilesystemPath(raw: string, context: FilesystemScopeContext): Promise<void> {
+  if (!isAbsolute(context.workingDirectory) || !isAbsolute(context.workspaceRoot)) {
+    throw new Error("Filesystem scope requires absolute session directories");
+  }
+  const target = resolve(context.workingDirectory, raw);
+  if (!isOrdinaryLocalPath(raw) || !isOrdinaryLocalPath(target)) {
+    throw new Error("Filesystem policy rejects network, device, or account paths");
+  }
+  const actual = await canonicalTarget(target);
+  if (!isOrdinaryLocalPath(actual)) throw new Error("Filesystem policy rejects resolved path");
+  if (context.filesystemScope !== "machine") {
+    if (!contained(resolve(context.workspaceRoot), target) ||
+        !contained(await realpath(context.workspaceRoot), actual)) {
+      throw new Error("Filesystem path is outside the session workspace");
+    }
+  }
+}
+
+/** Validate the final tool target before asking and again before executing. */
+export async function assertToolFilesystemScope(
+  toolName: string, input: unknown, context: FilesystemScopeContext,
+): Promise<void> {
+  if (!LOCAL_FILESYSTEM_TOOLS.has(toolName)) return;
+  const value = input as Record<string, unknown>;
+  if (!value || typeof value !== "object") throw new Error("Invalid filesystem tool input");
+  const raw = ["Read", "Write", "Edit"].includes(toolName) ? value.file_path
+    : toolName === "Bash" ? context.workingDirectory : value.path ?? context.workingDirectory;
+  if (typeof raw !== "string") throw new Error("Missing filesystem tool path");
+  if (toolName === "Glob" && typeof value.pattern === "string" &&
+      (isAbsolute(value.pattern) || value.pattern.split(/[\\/]/).includes("..") || value.pattern.includes(":"))) {
+    throw new Error("Glob pattern must stay within its search root");
+  }
+  await assertFilesystemPath(raw, context);
+}
