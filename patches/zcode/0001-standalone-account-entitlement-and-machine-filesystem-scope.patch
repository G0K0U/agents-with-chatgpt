+
+    // JWT 缺失（只有 activeProvider + userInfo）→ Start 无权益。
+    const missingJwt = fakeCredentialStore({
+      [SHARED_ZCODE_CREDENTIAL_KEYS.activeProvider]: "zai",
+      [SHARED_ZCODE_CREDENTIAL_KEYS.zaiUserInfo]: JSON.stringify({ id: "user-1" }),
+    });
+    assert.equal(
+      (await readStandaloneStartPlanEntitlementByFamily(missingJwt)).get("zai"),
+      false,
