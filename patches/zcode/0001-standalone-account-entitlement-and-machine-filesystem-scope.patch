+test("session entitlement readback never fabricates observed facts", () => {
+  const app = {
+    runtime: {
+      getSessionModelSelection: () => ({
+        providerId: "account:zai-start-plan",
+        modelId: "GLM-5.3-Flash",
+      }),
+    },
+    getModelOption: (selection: { providerId: string; modelId: string }) =>
+      selection.providerId === "account:zai-start-plan"
+        ? {
+            ref: selection,
+            label: "GLM-5.3-Flash",
+            properties: { inputFormat: "text" as const, outputFormat: "text" as const },
+            accountAccess: {
+              type: "zhipu-account" as const,
+              accountType: "zai" as const,
+              mode: "start-plan" as const,
+              entitled: true,
+            },
+          }
+        : undefined,
+    listModels: () => [],
+  };
+  const readback = sessionEntitlementReadback(app, "start-plan");
+  assert.deepEqual(readback, {
+    requested: "start-plan",
+    observed: {
+      type: "zhipu-account",
+      accountType: "zai",
+      mode: "start-plan",
+      entitled: true,
+    },
+    source: "provider-registry",
+  });
+  assertSessionEntitlement(app, "start-plan", "test");
+  assert.throws(() => assertSessionEntitlement(app, "individual-coding-plan", "test"));
+
+  const unresolvable = {
+    runtime: { getSessionModelSelection: () => undefined },
+    getModelOption: () => undefined,
+    listModels: () => [],
+  };
+  const unavailable = sessionEntitlementReadback(unresolvable, undefined);
+  assert.equal(unavailable.requested, undefined);
+  assert.equal(unavailable.observed, null);
+  assert.equal(unavailable.source, "unavailable");
+  assert.throws(() => assertSessionEntitlement(unresolvable, "start-plan", "test"));
+});
