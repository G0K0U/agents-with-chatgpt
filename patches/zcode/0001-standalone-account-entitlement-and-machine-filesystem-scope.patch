+/** Minimal in-memory stand-in for the shared credential store. */
+function fakeCredentialStore(initial: Record<string, string>): SharedZCodeCredentialStore {
+  const values = new Map(Object.entries(initial));
+  return {
+    filePath: "<memory>",
+    async clearZaiLoginCredentials() {
+      for (const key of [
+        SHARED_ZCODE_CREDENTIAL_KEYS.zaiAccessToken,
+        SHARED_ZCODE_CREDENTIAL_KEYS.zaiRefreshToken,
+        SHARED_ZCODE_CREDENTIAL_KEYS.zaiUserInfo,
+        SHARED_ZCODE_CREDENTIAL_KEYS.zcodeJwtToken,
+      ])
+        values.delete(key);
+    },
+    async delete(key) {
+      values.delete(key);
+    },
+    async deleteIfValue(key, expected) {
+      const deleted = values.get(key) === expected;
+      if (deleted) values.delete(key);
+      return deleted;
+    },
+    async deleteIfValues(expected) {
+      const result: Record<string, boolean> = {};
+      for (const [key, value] of Object.entries(expected)) {
+        result[key] = values.get(key) === value;
+        if (result[key]) values.delete(key);
+      }
+      return result;
+    },
+    async deleteManyIfValue(guardKey, guardValue, keys) {
+      if (values.get(guardKey) !== guardValue) return false;
+      for (const key of keys) values.delete(key);
+      return true;
+    },
+    async load(key) {
+      return values.get(key) ?? null;
+    },
+    async loadMany(keys) {
+      return Object.fromEntries(keys.map((key) => [key, values.get(key) ?? null]));
+    },
+    async save(key, value) {
+      values.set(key, value);
+    },
+    async saveMany(entries) {
+      for (const [key, value] of Object.entries(entries)) values.set(key, value);
+    },
+    async saveReplacing(key, value, replacedKeys) {
+      values.set(key, value);
+      for (const replaced of replacedKeys) if (replaced !== key) values.delete(replaced);
+    },
+    async saveZaiLoginCredentials() {
+      throw new Error("not needed in tests");
+    },
+  } as unknown as SharedZCodeCredentialStore;
+}
+
+/**
