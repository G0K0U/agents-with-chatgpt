+export function isStandaloneAccountRuntimeEnabled(
+  env: Readonly<Record<string, string | undefined>>,
+): boolean {
+  const raw = env[ZCODE_PROTOCOL_STANDALONE_ACCOUNT_RUNTIME_ENV]?.trim().toLowerCase();
