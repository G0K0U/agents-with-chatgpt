+import type {
+  ModelSelection,
+  ZCodeModelOption,
+  ZCodeSessionEntitlement,
+} from "@zcode/shared";
+import type { ZCodeApp } from "../app/types.js";
+import { ProtocolRequestError } from "./server-types.js";
+
+/**
+ * 会话级语义权益（billing entitlement）的运行时强制与权威回读。
+ *
+ * 权益语义 = zhipu 账号 planKind（"start-plan" | "individual-coding-plan"），
+ * 显式声明、显式核对；绝不从 Provider ID、模型名或请求参数推断。DEFAULT
+ * （不声明）保持历史行为，不做任何权益收窄。
+ */
+export type SessionEntitlementPlan = NonNullable<ZCodeSessionEntitlement["requested"]>;
+
+/** 权益回读里的 observed/access 事实只来自 Registry 已准入 Provider 的 access 约束。 */
+export type SessionEntitlementAccess = NonNullable<ZCodeSessionEntitlement["observed"]>;
+
+/**
+ * 当前会话绑定选择的语义权益事实。返回 null 表示本轮无法给出权益事实
+ * （未绑定模型、Provider 不是账号型，或 runtime 未暴露 access 约束）。
+ */
+export function observeSessionEntitlement(
+  app: Pick<ZCodeApp, "getModelOption" | "listModels"> & {
+    runtime: { getSessionModelSelection(): ModelSelection | undefined };
+  },
+): { observed: SessionEntitlementAccess | null; source: "provider-registry" | "unavailable" } {
+  const selection = app.runtime.getSessionModelSelection();
+  const option = selection
+    ? (app.getModelOption?.(selection) ??
+      app.listModels().find(
+        (candidate) =>
+          candidate.ref.providerId === selection.providerId &&
+          candidate.ref.modelId === selection.modelId,
+      ))
+    : undefined;
+  const access = option?.accountAccess;
+  return access?.type === "zhipu-account"
+    ? { observed: access, source: "provider-registry" }
+    : { observed: null, source: "unavailable" };
+}
+
+/** Registry 目录中第一个声明匹配权益的候选（确定性：按 Registry 顺序）。 */
+export function firstEntitlementMatchedModelOption(
+  app: Pick<ZCodeApp, "listModels">,
+  entitlement: SessionEntitlementPlan,
+): ZCodeModelOption | undefined {
+  return app.listModels().find((option) => option.accountAccess?.mode === entitlement);
+}
+
+/**
+ * 权益路由的程序化 setModel 需要的档位：请求档位优先（且必须被该模型
+ * 支持），否则用模型自身的默认档位。返回 undefined 表示该模型不要求档位，
+ * Selection 保持不带 options（严格校验仅在要求档位的模型上触发）。
+ */
+export function resolveEntitlementRouteReasoningLevel(
+  matched: ZCodeModelOption,
+  requested: string | undefined,
+): string | undefined {
+  const levels = matched.reasoning?.levels ?? [];
+  // 该模型不声明任何档位能力时不得硬塞档位（严格校验也不会要求它）。
+  if (levels.length === 0) return undefined;
+  const requestedLevel = requested?.trim();
+  if (requestedLevel && levels.some((l) => l.value === requestedLevel)) {
+    return requestedLevel;
+  }
+  return matched.reasoning?.defaultLevel ?? levels.at(-1)?.value;
+}
+
+/**
+ * 把“当前会话选择”与请求权益严格对账。不一致或缺证据都抛协议错误（fail
+ * closed），调用方负责回滚会话；不存在静默降级或跨权益回退。
+ */
+export function assertSessionEntitlement(
+  app: Parameters<typeof observeSessionEntitlement>[0],
+  entitlement: SessionEntitlementPlan,
+  phase: string,
+): void {
+  const { observed, source } = observeSessionEntitlement(app);
+  if (source !== "provider-registry" || !observed) {
+    throw new ProtocolRequestError(
+      -32002,
+      `Entitlement ${entitlement} could not be attested for this session (${phase}): no registry-backed account access fact for the current model selection`,
+    );
+  }
+  if (observed.mode !== entitlement) {
+    throw new ProtocolRequestError(
+      -32002,
+      `Entitlement mismatch for this session (${phase}): requested ${entitlement}, observed ${observed.mode}`,
+    );
+  }
+}
+
+/** setModel/初始模型前的权益约束核对：候选模型必须声明匹配的账号访问类别。 */
+export function assertModelOptionMatchesEntitlement(
+  option: ZCodeModelOption | undefined,
+  entitlement: SessionEntitlementPlan,
+): void {
+  if (!option) return; // 未知候选由 Registry 校验按原路径失败，不在这里重复报错。
+  if (option.accountAccess?.mode !== entitlement) {
+    throw new ProtocolRequestError(
+      -32002,
+      `Entitlement mismatch: requested ${entitlement}, candidate model ${option.ref.providerId}/${option.ref.modelId} is bound to ${option.accountAccess?.mode ?? "no account access"}`,
+    );
+  }
+}
+
+/** session/read settings.entitlement 回读（无凭据、可审计）。 */
+export function sessionEntitlementReadback(
+  app: Parameters<typeof observeSessionEntitlement>[0],
+  entitlement: SessionEntitlementPlan | undefined,
+): ZCodeSessionEntitlement {
+  const { observed, source } = observeSessionEntitlement(app);
+  return {
+    ...(entitlement ? { requested: entitlement } : {}),
+    observed,
+    source,
+  };
+}
