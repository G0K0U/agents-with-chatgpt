+import assert from "node:assert/strict";
+import test from "node:test";
+import { activateSessionForResume } from "../src/zcode-protocol/server-operations.js";
+
+test("active scope is immutable and omitted scope preserves it", async () => {
+  for (const filesystemScope of ["workspace", "machine"] as const) {
+    const record = { filesystemScope };
+    const context = { sessions: new Map([["test", record]]), deps: {} } as any;
+    assert.equal((await activateSessionForResume(context, { sessionId: "test" } as any)).record, record);
+    assert.equal((await activateSessionForResume(context, { sessionId: "test", filesystemScope } as any)).record, record);
+    await assert.rejects(activateSessionForResume(context, { sessionId: "test", filesystemScope: filesystemScope === "machine" ? "workspace" : "machine" } as any), /Cannot change/);
+  }
+});
+test("cold resume requires explicit scope after deactivation wait", async () => {
+  const sessions = new Map([["test", { filesystemScope: "machine" }]]);
+  const context = { sessions, deps: {}, sessionResidentPool: { waitForDeactivation: async () => { sessions.clear(); } } } as any;
+  await assert.rejects(activateSessionForResume(context, { sessionId: "test" } as any), /explicit filesystem scope/);
+});
+test("scope is checked against the session present after the wait", async () => {
+  const sessions = new Map();
+  const context = { sessions, deps: {}, sessionResidentPool: { waitForDeactivation: async () => { sessions.set("test", { filesystemScope: "workspace" }); } } } as any;
+  await assert.rejects(activateSessionForResume(context, { sessionId: "test", filesystemScope: "machine" } as any), /Cannot change/);
+});
