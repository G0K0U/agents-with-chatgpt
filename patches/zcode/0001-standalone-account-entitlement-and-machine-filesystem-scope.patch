+++ b/apps/zcode-cli/packages/core/test/filesystem-scope.test.ts
@@ -0,0 +1,125 @@
+import assert from "node:assert/strict";
+import { mkdtemp, mkdir, writeFile, symlink, rm } from "node:fs/promises";
+import { readFile } from "node:fs/promises";
+import { readToolEntry } from "../src/tool/handlers/read.js";
+import { bashToolEntry } from "../src/tool/handlers/bash.js";
+import { join } from "node:path";
+import { test, before, after } from "node:test";
+import { assertToolFilesystemScope, isOrdinaryLocalPath } from "../src/tool/filesystem-scope.js";
+import { resolveWorkspacePath, resolveToolWorkingDirectory } from "../src/tool/path-policy.js";
+import { decideBashCwdPolicy } from "../src/tool/handlers/bash-cwd-policy.js";
+import { globToolEntry } from "../src/tool/handlers/glob.js";
+import { grepToolEntry } from "../src/tool/handlers/grep.js";
+import { resolveToolPermission } from "../src/tool/executor/permission-flow.js";
+import { PermissionService } from "../src/permission/service.js";
+import { resolveRuntimeEmbeddedSearchEnabled, filterEmbeddedSearchRuntimeVisibleTools } from "../src/runtime/methods/embedded-search-branch.js";
+
+test("machine-local runtime retains dedicated Glob/Grep discovery", () => {
+  const runtime = { config: { filesystemScope: "machine" } } as any;
+  assert.equal(resolveRuntimeEmbeddedSearchEnabled(runtime), false);
+  const tools = [globToolEntry, grepToolEntry].map(entry => ({ name: entry.metadata.name })) as any;
+  assert.deepEqual(filterEmbeddedSearchRuntimeVisibleTools(runtime, tools), tools);
+});
+
+let root: string, workspace: string, outside: string;
+before(async () => {
+  root = await mkdtemp(join(process.cwd(), "zcode-path-policy-"));
+  workspace = join(root, "workspace"); outside = join(root, "external");
+  await mkdir(workspace); await mkdir(outside);
+  await writeFile(join(outside, "source.ts"), "needle");
+  await symlink(outside, join(workspace, "escape"), "junction");
+});
+after(async () => { await rm(root, { recursive: true, force: true }); });
+const context = (machine = true) => ({ workingDirectory: workspace, workspaceRoot: workspace,
+  ...(machine ? { filesystemScope: "machine" as const } : {}) });
+
+for (const tool of ["Read", "Write", "Edit", "Glob", "Grep", "Bash"]) {
+  test(`${tool}: external targets require machine scope`, async () => {
+    const input = ["Read", "Write", "Edit"].includes(tool)
+      ? { file_path: join(outside, "source.ts") } : { path: outside, pattern: "*.ts", command: "node --version" };
+    const ctx = { ...context(), ...(tool === "Bash" ? { workingDirectory: outside } : {}) };
+    await assertToolFilesystemScope(tool, input, ctx);
+    await assert.rejects(assertToolFilesystemScope(tool, input, { ...ctx, filesystemScope: undefined }));
+    const resolveInput = { ...ctx, inputPath: outside, operation: "read" as const };
+    assert.equal(resolveWorkspacePath(resolveInput), outside);
+    assert.throws(() => resolveWorkspacePath({ ...resolveInput, filesystemScope: undefined }));
+  });
+}
+test("workspace paths work by default; symlink escapes fail including new write targets", async () => {
+  await assertToolFilesystemScope("Read", { file_path: join(workspace, "new.ts") }, context(false));
+  await assert.rejects(assertToolFilesystemScope("Write", { file_path: join(workspace, "escape/new/file.ts") }, context(false)));
+  await assertToolFilesystemScope("Write", { file_path: join(workspace, "escape/new/file.ts") }, context());
+});
+test("network, device, drive-relative and glob escape paths fail closed", async () => {
+  for (const path of ["//server/share", "\\\\server\\share", "\\\\?\\C:\\data", "C:relative", "NUL", "/dev/null", "file:stream"]) {
+    assert.equal(isOrdinaryLocalPath(path), false, path);
+    await assert.rejects(assertToolFilesystemScope("Read", { file_path: path }, context()));
+  }
+  await assert.rejects(assertToolFilesystemScope("Glob", { path: outside, pattern: "../**" }, context()));
+});
+test("Glob directory listing and Grep dispatch the external search root", async () => {
+  const seen: string[] = [];
+  const ctx = { ...context(), fileSystemPort: {
+    searchFiles: async ({ path }: { path: string }) => { seen.push(path); return { files: [join(path, "source.ts")], durationMs: 1, truncated: false }; },
+    searchText: async ({ path }: { path: string }) => { seen.push(path); return { files: [join(path, "source.ts")], matches: [], entries: [], durationMs: 1, truncated: false }; },
+  }};
+  await globToolEntry.handler({ path: outside, pattern: "*.ts" }, ctx as any);
+  await grepToolEntry.handler({ path: outside, pattern: "needle" }, ctx as any);
+  assert.deepEqual(seen, [outside, outside]);
+  await assert.rejects(globToolEntry.handler({ path: outside, pattern: "*" }, { ...ctx, filesystemScope: undefined } as any));
+});
+test("process cwd is retained only for machine scope", () => {
+  assert.equal(resolveToolWorkingDirectory(undefined, { ...context(), workingDirectory: outside, operation: "execute" }), outside);
+  assert.throws(() => resolveToolWorkingDirectory(undefined, { ...context(false), workingDirectory: outside, operation: "execute" }));
+  const input = { resolvedCwd: outside, workspaceRoot: workspace, status: "completed" as const, exitCode: 0 };
+  assert.equal(decideBashCwdPolicy({ ...input, filesystemScope: "machine" }).nextWorkingDirectory, outside);
+  assert.equal(decideBashCwdPolicy(input).nextWorkingDirectory, workspace);
+  assert.equal(decideBashCwdPolicy({ ...input, filesystemScope: "machine", resolvedCwd: "//server/share" }).nextWorkingDirectory, workspace);
+});
+test("machine scope requires the broker for each call even with yolo/preapproval; deny and plan remain closed", async () => {
+  let calls = 0, allow = true;
+  const deps = { ...context(), getWorkingDirectory: () => workspace, getWorkspaceRoot: () => workspace,
+    sessionId: "test", emitEvent: async () => {}, permissionService: new PermissionService(),
+    permissionBroker: { requestPermission: async () => { calls++; return { decision: allow ? "allow" : "deny" }; } },
+    hookRunner: { run: async () => { throw new Error("Machine approval must not run permission hooks"); } },
+  };
+  const input = { path: outside, pattern: "*.ts" };
+  const invoke = (mode = "yolo", entry = globToolEntry) => resolveToolPermission(deps as any,
+    { id: "call", name: entry.metadata.name, input } as any, { ...entry, prepareApproval: () => ({ gate: "proceed" }) } as any,
+    input, { permissionBehavior: "allow" } as any, mode as any, { traceId: "test" } as any);
+  assert.equal((await invoke()).allowed, true);
+  assert.equal((await invoke()).allowed, true);
+  assert.equal(calls, 2);
+  allow = false;
+  assert.equal((await invoke()).allowed, false);
+  assert.equal(calls, 3);
+  const write = { ...globToolEntry, metadata: { ...globToolEntry.metadata, name: "Write", readOnly: false } };
+  const denied = await resolveToolPermission(deps as any, { id: "write", name: "Write" } as any, write,
+    { file_path: join(outside, "new.ts") }, {} as any, "plan", { traceId: "test" } as any);
+  assert.equal(denied.allowed, false);
+  assert.equal(calls, 3);
+});
+
+test("Read dispatches an external file and returns its contents", async () => {
+  const file = join(outside, "source.ts");
+  const ctx = { ...context(), fileSystemPort: {
+    stat: async ({ path }: any) => { assert.equal(path, file); return { kind: "file", sizeBytes: 6, mtimeMs: 1 }; },
