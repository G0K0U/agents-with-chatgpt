{
  "name": "zcode-with-chatgpt",
  "version": "0.1.0",
  "private": true,
  "description": "Z2C bridge: bounded MCP control plane in front of the native open-source ZCode agent (zcode app-server --stdio)",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": { "node": ">=20" },
  "bin": {
    "z2c": "./bin/z2c.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "service": "tsx src/service/main.ts",
    "z2c": "tsx src/cli/z2c.ts",
    "test": "tsx --test --test-concurrency=2 test/*.test.ts",
    "canary:official": "tsx src/canary/official.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT"
}
